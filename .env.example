# Copy to .env and fill in, or export these in your shell / CI.
# The CLI reads ./.env and ./.env.local automatically (never overriding real env vars).
# Create an API key at https://typefully.com/?settings=api
TYPEFULLY_API_KEY=

# Optional
# TYPEFULLY_SOCIAL_SET=54758          # default account; see `typefully social-sets list`
# TYPEFULLY_DEFAULT_PLATFORMS=x,bluesky
# TYPEFULLY_BASE_URL=https://api.typefully.com/v2
# TYPEFULLY_PROFILE=default
# TYPEFULLY_CONFIG_DIR=~/.config/typefully
# TYPEFULLY_NO_DOTENV=1               # skip reading .env files
